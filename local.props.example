<!-- Copy to local.props (gitignored) if your game is not at the default Steam
     path.

     SubnauticaDir  the game install; the plugin build resolves
                    Assembly-CSharp.dll and the UnityEngine modules from it.
                    The SUBNAUTICA_INSTALLATION_PATH environment variable
                    wins over the default, same as the sibling repo.
-->
<Project>
  <PropertyGroup>
    <SubnauticaDir>/home/you/.local/share/Steam/Steamapps/common/Subnautica</SubnauticaDir>
  </PropertyGroup>
</Project>
